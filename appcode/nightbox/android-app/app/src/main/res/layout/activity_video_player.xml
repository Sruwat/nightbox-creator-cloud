<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Main content -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Scrollable content -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="60dp">

                <!-- Top Scrollable Banner Ad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="AD"
                        android:textColor="@color/primary_purple"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    <FrameLayout
                        android:id="@+id/adBannerContainerTop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp" />
                </LinearLayout>

                <!-- Video Player Container (16:9 in portrait) -->
                <FrameLayout
                    android:id="@+id/videoPlayerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black">

                    <!-- ExoPlayer PlayerView -->
                    <androidx.media3.ui.PlayerView
                        android:id="@+id/playerView"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        app:show_buffering="when_playing"
                        app:use_controller="true"
                        app:auto_show="true"
                        app:hide_on_touch="true"
                        app:resize_mode="fit"
                        app:surface_type="surface_view" />

                    <!-- WebView Fallback Player (hidden by default) -->
                    <WebView
                        android:id="@+id/webViewPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:visibility="gone" />

                    <!-- Back Arrow Overlay -->
                    <ImageView
                        android:id="@+id/btnBackOverlay"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="start|top"
                        android:layout_margin="12dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="Back"
                        app:tint="@color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="8dp" />

                    <!-- Fullscreen Toggle Button -->
                    <ImageView
                        android:id="@+id/btnFullscreen"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|bottom"
                        android:layout_margin="12dp"
                        android:padding="6dp"
                        android:src="@drawable/ic_fullscreen"
                        android:contentDescription="Fullscreen"
                        app:tint="@color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="8dp" />

                    <!-- Loading Overlay -->
                    <LinearLayout
                        android:id="@+id/loadingOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@color/black"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ProgressBar
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:indeterminateTint="@color/primary_purple"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvLoadingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Error Overlay -->
                    <LinearLayout
                        android:id="@+id/errorOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:background="@color/black"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❌"
                            android:textSize="36sp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:id="@+id/tvErrorMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/error_playback"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginBottom="16dp" />

                        <Button
                            android:id="@+id/btnRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_button_primary"
                            android:text="Retry"
                            android:textColor="@color/white"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:paddingHorizontal="28dp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Video Meta Details ("1:20 min 30 MB") -->
                <TextView
                    android:id="@+id/tvVideoMetaDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:background="@color/bg_dark" />

                <!-- Banner Ad Below Video (Middle) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_button"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:text="AD"
                        android:textColor="@color/primary_purple"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"
                        android:layout_marginTop="8dp" />
                    <FrameLayout
                        android:id="@+id/adBannerContainerPlayer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp" />
                </LinearLayout>

                <!-- Action Buttons (Centered) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="16dp">

                    <!-- Share Button Pill -->
                    <LinearLayout
                        android:id="@+id/btnShare"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/text_primary_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/share"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>


                    <!-- Telegram Button Pill -->
                    <LinearLayout
                        android:id="@+id/btnTelegramJoin"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_button"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_telegram"
                            app:tint="@color/text_primary_dark" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Telegram"
                            android:textColor="@color/text_primary_dark"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Native Ad at Bottom -->
                <FrameLayout
                    android:id="@+id/nativeAdContainerBottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    android:minHeight="200dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Fullscreen Player Container (initially hidden, covers entire display) -->
    <FrameLayout
        android:id="@+id/fullscreenPlayerContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"
        android:elevation="100dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerViewFullscreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing"
            app:use_controller="true"
            app:auto_show="true"
            app:hide_on_touch="true"
            app:resize_mode="fit"
            app:surface_type="surface_view" />

        <!-- Exit Fullscreen Button -->
        <ImageView
            android:id="@+id/btnExitFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|bottom"
            android:layout_margin="16dp"
            android:padding="8dp"
            android:src="@drawable/ic_fullscreen_exit"
            android:contentDescription="Exit Fullscreen"
            app:tint="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp" />
    </FrameLayout>
    
    <!-- Sticky Bottom Banner Ad (fixed, doesn't scroll) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@color/bg_dark"
        android:elevation="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_button"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="AD"
            android:textColor="@color/primary_purple"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />
        <FrameLayout
            android:id="@+id/adBannerContainerSticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp" />
    </LinearLayout>
</FrameLayout>
