PORT=3000
NODE_ENV=development
DOMAIN_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:4173,http://localhost:4174
TRUST_PROXY=false
AUTH_SECRET=replace-with-a-long-random-secret
IP_HASH_SECRET=replace-with-a-separate-random-secret
VIEW_HASH_SECRET=replace-with-a-separate-random-secret
BLOCKED_IP_HASHES=
IPQUALITYSCORE_API_KEY=
# Keep true in production so an unavailable reputation provider fails closed.
BLOCK_ON_REPUTATION_FAILURE=true
MIN_WITHDRAWAL_USD_MICROS=10000000

BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=
BUNNY_STORAGE_PREFIX=nightbox
# Bunny Pull Zone token-auth security key. Keep this only on the primary VPS.
BUNNY_TOKEN_AUTH_KEY=
BUNNY_TOKEN_TTL_SECONDS=600
BUNNY_TOKEN_IP_LOCK=false
# API-side playback token signing secret. Generate a separate production value.
PLAYBACK_TOKEN_SECRET=replace-with-a-long-random-secret
PLAYBACK_TOKEN_TTL_SECONDS=60
# Set false only for a temporary rollback to raw MP4 playback.
ENABLE_HLS_TRANSCODE=true
TRANSCODE_CONCURRENCY=1
FFMPEG_PRESET=veryfast
FFMPEG_CRF=23
FFMPEG_MAXRATE=2200k
FFMPEG_BUFSIZE=4400k
FFMPEG_AUDIO_BITRATE=96k

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_API_KEY=replace-with-a-random-32-character-or-longer-key

# Configure a real payment provider before enabling checkout/webhooks.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_PRIORITY=
