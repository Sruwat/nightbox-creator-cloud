<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTermsAgreement"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="To use NightBox you must agree to our Terms &amp; Conditions and affirm you have reviewed our Privacy Policy.\n\nPlease press &quot;Continue&quot; if you choose to start using our app."
        android:textColor="@color/text_primary_dark"
        android:textSize="20sp"
        android:lineSpacingExtra="6dp" />

    <Button
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackground"
        android:text="CONTINUE"
        android:textColor="#80CBC4" 
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:padding="12dp" />

</LinearLayout>
