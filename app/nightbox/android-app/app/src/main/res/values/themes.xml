<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Dark Theme (default) -->
    <style name="Theme.NightBox" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryDark">@color/primary_purple_dark</item>
        <item name="colorAccent">@color/accent_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/status_bar_dark</item>
        <item name="android:navigationBarColor">@color/nav_bar_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
    </style>

    <!-- Light Theme -->
    <style name="Theme.NightBox.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryDark">@color/primary_purple_dark</item>
        <item name="colorAccent">@color/accent_violet</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/status_bar_light</item>
        <item name="android:navigationBarColor">@color/nav_bar_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Fullscreen theme for video player -->
    <style name="Theme.NightBox.Fullscreen" parent="Theme.NightBox">
        <item name="android:windowFullscreen">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Legacy compat aliases -->
    <style name="Theme.PrernaVideoPlayer" parent="Theme.NightBox" />
    <style name="Theme.PrernaVideoPlayer.Fullscreen" parent="Theme.NightBox.Fullscreen" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, animated icon, and animation duration. -->
        <item name="windowSplashScreenBackground">@color/bg_dark</item>
        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated drawable. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <!-- Set the theme of the Activity that directly follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.NightBox</item>
    </style>

</resources>
